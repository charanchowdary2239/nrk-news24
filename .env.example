# NRK News24 Environment Configuration Template

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Authentication Secret (Used for admin JWT signatures, min 32 chars)
JWT_SECRET=your_production_random_secret_string_here_min_32_chars

# Supabase PostgreSQL & Storage Configuration (Required for Vercel Production)
# Obtain these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Admin User Defaults (For reference/seeding)
ADMIN_NAME=NRK Editor
ADMIN_EMAIL=admin@nrknews24.com
ADMIN_PASSWORD=Admin@NRK2026!

# AI Configuration (Google Gemini API)
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Automated Ingestion Settings
CRON_ENABLED=true
CRON_SCHEDULE_MINUTES=30
